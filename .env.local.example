# Copy this file to .env.local for local development.
# On Vercel, set the same variable names under
# Project Settings → Environment Variables (never commit real secrets).

# From Google Cloud Console → APIs & Services → Credentials
# (OAuth 2.0 Client ID, application type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The public URL of the deployed site, e.g. https://haiko-portal.vercel.app
# Not required for local dev (defaults to http://localhost:3000).
NEXTAUTH_URL=

# Comma-separated list of the Google account emails allowed to log in.
# Edit this list (and redeploy, or just update the env var on Vercel) to
# add or remove members.
ALLOWED_EMAILS=taro@gmail.com,hanako@gmail.com
